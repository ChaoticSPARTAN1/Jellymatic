# SPDX-License-Identifier: GPL-3.0-or-later
# Additional terms: ADDITIONAL-TERMS.md
# Flash and boot settings must match the stock bootloader header (DIO, 40 MHz, 4 MB);
# scripts/compose_chromatic_image.py refuses an image where they differ.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y

# A hung launcher must end in the stock firmware. The bootloader's RTC watchdog stays
# armed in this app, which feeds it only from the live menu loop. Its reset is not a
# power-on reset, so the next boot goes to stock. Stock disables this itself.
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y

# The launcher never writes the owner's settings partition. Wi-Fi and PHY would
# otherwise store calibration and credentials in NVS.
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Required by the shared media component (chromatic/esp32_media.c).
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# The main loop runs the CHR1 handler, hashing and drawing: 8 KiB of stack (the review
# estimated a 2.6-2.8 KB worst path against the 3.5 KiB default). perf reports the
# high-water mark as stackFreeB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Reproducible builds: no date, time or build path in the bootloader or the app, so a
# rebuild of unchanged sources gives byte-identical bootloader.bin and app bin (Chromatic
# Manager compares them before deciding what to write).
CONFIG_APP_REPRODUCIBLE_BUILD=y
# CONFIG_APP_COMPILE_TIME_DATE is not set
# CONFIG_BOOTLOADER_COMPILE_TIME_DATE is not set

# Jellyfin streaming (launcher 1.2): 6 static Wi-Fi RX buffers are plenty for one ~100 KB/s
# stream and leave about 6 KB more heap for the player (the ESP32 has no PSRAM).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# Launcher 1.2.1: the first console run ran out of heap while browsing. Cap what Wi-Fi and lwIP
# may hold at once (each dynamic RX buffer is ~1.6 KB): 8 RX / 16 TX buffers and a 16-entry
# TCP/IP mailbox are ample for one ~125 KB/s stream plus small requests. After 1.2.4 (sound
# memory work): 8 RX buffers instead of 10 (the burst at a stream start held up to 16 KB and
# dipped the heap from 23 KB to 6.6 KB on the console; 8 caps it at 12.8 KB). The BA window (6)
# must stay at or under the smaller of 2 x static RX buffers (12) and the dynamic RX buffers (8).
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
